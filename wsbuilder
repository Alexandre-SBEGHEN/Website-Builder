#!/bin/bash

# --------------------------------------------------------------------------- #
#                               Website Builder                               #
#                         par Alexandre SBEGHEN, 2026                         #
# --------------------------------------------------------------------------- #

#
# --------------- Constantes ------------------------------------------------ #
#

readonly APP_NAME="$0"
readonly APP_VERSION="1.1.0"

readonly SASS_COMMAND="sass"

readonly BYPASS_INDEX_VERIFICATION=0
readonly BYPASS_SASS_VERIFICATION=0

readonly OPTION_BUILD_FORCE="--build-force"
readonly OPTION_SASS_COMPILE="--sass-compile"
readonly OPTION_SASS_COMPRESS="--sass-compress"
readonly OPTION_SASS_NO_MAP="--sass-no-source-map"
readonly OPTION_CSS_MINIFY="--css-minify"
readonly OPTION_JS_MINIFY="--js-minify"

readonly BUILD_IGNORE=("$(basename "$APP_NAME")" ".git" ".gitignore" "README.md" "LICENSE" ".idea" ".env.model")

#
# --------------- Fonctions d'affichage ------------------------------------- #
#

# Afficher le header de l'application
# i.e : Nom, auteur, version, etc
print_app_header() {
 echo "Website Builder, Alexandre SBEGHEN, 2026"
 echo "Version ${APP_VERSION}"
 echo "GitHub: https://github.com/Alexandre-SBEGHEN"
 echo "Repo: https://github.com/Alexandre-SBEGHEN/Website-Builder"
}

# Afficher le guide d'utilisation de l'application
print_app_usage() {
 echo "Usage: ${APP_NAME} [<options>...] <index_directory>"
 echo
 echo "<Options>"
 printf "  %-20s : %s" "$OPTION_BUILD_FORCE"               "Force build even when index not found (risky)"; echo
 printf "  %-20s : %s" "$OPTION_SASS_COMPILE"               "Compile your sass to CSS (requires Dart Sass)"; echo
 printf "  %-20s : %s" "$OPTION_SASS_COMPRESS"  "Minify the compiled Sass"; echo
 printf "  %-20s : %s" "$OPTION_SASS_NO_MAP"                "Prevent Sass from creating source maps"; echo
 printf "  %-20s : %s" "$OPTION_CSS_MINIFY"                 "Minify your CSS"; echo
 printf "  %-20s : %s" "$OPTION_JS_MINIFY"                  "Minify your JavaScript"; echo
}

# Affiche le header d'un message d'erreur
print_error_header() {
 echo "Command line error" >&2
}

# Affiche une ERREUR -> le dernier argument n'est PAS un répertoire
print_error_last_arg_not_index_repertory() {
 echo "Last argument must be the index directory" >&2
}

# Affiche une ERREUR -> Option inconnue
print_error_unknown_command() {
  echo "Unknown command: ${1}" >&2
}

# Affiche une ERREUR -> Sass n'est pas installé
print_error_sass_not_found() {
    echo "Sass could not be found" >&2
}

# Affiche une ERREUR -> index du site (php/html) non trouvé
print_error_index_not_found() {
 echo "HTML or PHP index not found at '${1}'" >&2
}

# Affiche une INFO -> Le build a été effectué avec succès
print_info_build_success() {
  echo "Website compiled successfully to '${1}'"
}

#
# --------------- Programme principal --------------------------------------- #
#

# Arguments
argc=$#
last_arg="${!#}"

# Afficher le header
echo
print_app_header
echo

# Afficher le guide d'utilisation (si 0 argument)
if (( argc == 0 )); then
 print_app_usage
 echo
 exit 0
fi

# ---------- Options ----------
option_build_force=0
option_sass_compile=0
option_sass_compress=0
option_sass_no_map=0
option_css_minify=0
option_js_minify=0
for o in "${@:1:$#-1}"; do # Tous les arguments SAUF le dernier
  if [[ "$o" == "$OPTION_BUILD_FORCE" ]]; then
    option_build_force=1
    continue
  elif [[ "$o" == "$OPTION_SASS_COMPILE" ]]; then
    option_sass_compile=1
    continue
  elif [[ "$o" == "$OPTION_SASS_COMPRESS" ]]; then
    option_sass_compress=1
    continue
  elif [[ "$o" == "$OPTION_SASS_NO_MAP" ]]; then
      option_sass_no_map=1
      continue
  elif [[ "$o" == "$OPTION_CSS_MINIFY" ]]; then
    option_css_minify=1
    continue
  elif [[ "$o" == "$OPTION_JS_MINIFY" ]]; then
    option_js_minify=1
    continue
  fi

  # Commande inconnue
  print_error_header
  print_error_unknown_command "$o"
  echo
  exit 1
done

# ---------- Vérification de Sass (si actif) ----------
if (( BYPASS_SASS_VERIFICATION == 0 && option_sass_compile == 1)) \
    && ! command -v "$SASS_COMMAND" >/dev/null 2>&1; then

    print_error_header
    print_error_sass_not_found
    echo
    exit 1
fi

# ---------- Vérification de l'index ----------
if (( BYPASS_INDEX_VERIFICATION == 0 && option_build_force == 0 )); then
 # Le dernier argument est-il un répertoire ?
 if [[ ! -d "$last_arg" ]]; then
   print_error_header
   print_error_last_arg_not_index_repertory
   echo
   exit 1
 fi

 # Un index existe-t-il dans le répertoire ?
 if [[ ! -f "${last_arg}/index.html" && ! -f "${last_arg}/index.php" ]]; then
   print_error_header
   print_error_index_not_found "$last_arg"
   echo
   exit 1
 fi
fi
website_directory="$last_arg"

# ---------- Vidage / Création du dossier build ----------
build_directory="${website_directory}/build"
mkdir -p "$build_directory" && find "$build_directory" -delete 2>/dev/null && cp -r "$website_directory" "$build_directory"

# Suppression des fichiers à ignorer
(( ${#BUILD_IGNORE[@]} > 0)) && rm -rf "${BUILD_IGNORE[@]/#/$build_directory/}"

# ---------- CSS, JS ----------
if (( option_css_minify == 1 || option_js_minify == 1 )); then
  find build -type f \( -name "*.css" -o -name "*.js" \) -print0 | while IFS= read -r -d '' f; do
    extension="${f##*.}"
    if [[ ($option_js_minify -eq 1 && "$extension" = "js") || \
      ($option_css_minify -eq 1 && "$extension" = "css") ]]; then

      # Commentaires
      content=$(cat "$f")
      len="${#content}"

      state="CODE"
      output=""
      # Algorithme de suppression des commentaires
      # (pseudo-code issu de Claude, traduit en bash par moi)
      for (( i=0; i<len; ++i )); do
          c="${content:$i:1}"
          next="${content:((i+1)):1}"
          (( i == len-1 )) && next="EOF"

          if [[ "$state" = "CODE" ]]; then
              if [[ "$c" = "\"" || "$c" = "'" || "$c" = "\`" ]]; then
                  state="STRING"
                  delimiter="$c"
                  output+="$c"
              elif [[ "$c" = "/" && "$next" = "/" ]]; then
                  state="COMMENT_LINE"
                  ((i+=1))
              elif [[ "$c" = "/" && "$next" = "*" ]]; then
                  state="COMMENT_BLOCK"
                  ((i+=1))
              elif [[ "$c" = " " && "$next" = " " ]]; then
                  ((i+=1))
              else
                  output+="$c"
              fi
          elif [[ "$state" = "STRING" ]]; then
              output+="$c"
              if [[ "$c" = '\\' ]]; then
                  output+="$next"
                  ((i+=1))
              elif [[ "$c" = "$delimiter" ]]; then
                  state="CODE"
              fi
          elif [[ "$state" = "COMMENT_LINE" ]]; then
              if [[ "$c" = $'\n' ]]; then
                  state="CODE"
                  output+="$c"
              fi
          elif [[ "$state" = "COMMENT_BLOCK" ]]; then
              if [[ "$c" = "*" && "$next" = "/" ]]; then
                  state="CODE"
                  ((i+=1))
              fi
          fi

          # output+="$c"
      done

      # Enregistrer sans retours à la ligne
      echo "$output" | tr '\t' ' ' | tr -d '\r\n' > "$f"
    fi
  done
fi

# ---------- Sass ----------
if (( option_sass_compile == 1 )); then
  #for f in $(find "$build_directory" -type f -name "*.scss"); do
  find "$build_directory" -type f -name "*.scss" -print0 | while IFS= read -r -d '' f; do
    [[ $(basename $f) != _*.scss ]] && "$SASS_COMMAND" \
      $( (( option_sass_compress )) && echo "--style=compressed") \
      $( (( option_sass_no_map )) && echo "--no-source-map") \
      "$f" \
      "${f%.*}.css"
  done
fi

find "$build_directory" -type f -name "*.scss" -delete

# ---------- Succès ----------
print_info_build_success "$build_directory"
echo
exit 0
